# Set true only when you want to verify the UI without invoking yt-dlp.
MEDIA_ENGINE_MOCK=false

# Optional: override the yt-dlp executable path if your environment needs it.
# YT_DLP_BINARY=/absolute/path/to/yt-dlp

# Required in production. YouTube answers datacenter IPs (Vercel included) with
# "Sign in to confirm you're not a bot" for most videos, so yt-dlp needs a cookie
# jar from a signed-in account. Export cookies.txt (Netscape format) from a
# throwaway Google account and paste it here base64-encoded, or as raw file text.
# See README.md -> "YouTube cookies" for the export steps.
# YOUTUBE_COOKIES=IyBOZXRzY2FwZSBIVFRQIENvb2tpZSBGaWxlCg==
