# Set true only when you want to verify the UI without invoking yt-dlp.
MEDIA_ENGINE_MOCK=false

# Optional: override the yt-dlp executable path if your environment needs it.
# YT_DLP_BINARY=/absolute/path/to/yt-dlp

# Required in production. YouTube, Instagram and X answer datacenter IPs (Vercel
# included) with a sign-in demand for most media, so yt-dlp needs a cookie jar from
# signed-in accounts. One Netscape cookies.txt covers every domain at once; paste it
# here base64-encoded, or as raw file text.
# See README.md -> "Cookies (required in production)" for the export steps.
# MEDIA_COOKIES=IyBOZXRzY2FwZSBIVFRQIENvb2tpZSBGaWxlCg==
